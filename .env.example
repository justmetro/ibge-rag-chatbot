# Opcional: sem chave, o app funciona em modo demo.
# Crie uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelos Gemini tentados em ordem, separados por vírgula (todos gratuitos).
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Quantidade de trechos recuperados por pergunta.
RETRIEVER_K=5
